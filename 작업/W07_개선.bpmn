    <bpmn:sequenceFlow id="W07I_Flow19" sourceRef="W07I_Outcome" targetRef="W07I_Prepay" name="필요 결재 모두 승인">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">같은 버전에 필요한 모든 결재가 승인됨</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow20" sourceRef="W07I_Outcome" targetRef="W07I_Rework" name="보완·근거 변경">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">보완 요청 또는 승인 근거 변경</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow21" sourceRef="W07I_Outcome" targetRef="W07I_Rejected" name="반려">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">반려 결정</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow22" sourceRef="W07I_Rework" targetRef="W07I_Review" name="증빙 확보 후 재검토"/>
    <bpmn:sequenceFlow id="W07I_Flow23" sourceRef="W07I_Prepay" targetRef="W07I_Rework" name="변경 발견">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">필수 결재 또는 승인 근거 버전 불일치</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow24" sourceRef="W07I_Prepay" targetRef="W07I_Pay" name="유효">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">모든 지급 조건 유효</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow25" sourceRef="W07I_Pay" targetRef="W07I_Reconcile"/>
    <bpmn:sequenceFlow id="W07I_Flow26" sourceRef="W07I_Reconcile" targetRef="W07I_Finish"/>
    <bpmn:sequenceFlow id="W07I_Flow27" sourceRef="W07I_Risk" targetRef="W07I_AIReview" name="보류·추가 판단"/>
    <bpmn:sequenceFlow id="W07I_Flow28" sourceRef="W07I_AIReview" targetRef="W07I_AIRoute"/>
    <bpmn:sequenceFlow id="W07I_Flow29" sourceRef="W07I_AIRoute" targetRef="W07I_Supplement" name="자료 보완">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">서버가 검증한 AI 판단에서 보강할 자료가 특정됨</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow30" sourceRef="W07I_AIRoute" targetRef="W07I_Rework" name="회계 확인·상위 보고"/>
    <bpmn:sequenceFlow id="W07I_Flow31" sourceRef="W07I_Supplement" targetRef="W07I_Rework" name="보완 회신"/>
    <bpmn:sequenceFlow id="W07I_Flow32" sourceRef="W07I_Risk" targetRef="W07I_Delegated" name="일반 · 200만 원 이하">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">검토가 완료된 200만 원 이하 일반 건이며 접수자와 다른 영업지원팀장(전결)가 배정됨</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow33" sourceRef="W07I_Delegated" targetRef="W07I_Outcome"/>
