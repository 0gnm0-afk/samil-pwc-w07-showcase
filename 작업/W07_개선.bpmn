<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="W07I_Definitions" targetNamespace="https://ax-challenge.local/bpmn/w07-improved">
  <bpmn:collaboration id="W07I_Collaboration">
    <bpmn:participant id="W07I_Pool" name="Corevia 판매장려금 지급 검토" processRef="W07I_Process"/>
  </bpmn:collaboration>
  <bpmn:process id="W07I_Process" name="W07 판매장려금 지급 개선 흐름" isExecutable="false">
    <bpmn:documentation>설계 기준은 작업/W07_문제정리.md 22.19절. 결재 요청과 지급 권한은 동일한 근거 버전으로 관리한다.</bpmn:documentation>
    <bpmn:laneSet id="W07I_Lanes">
      <bpmn:lane id="W07I_LaneIntake" name="일반 영업지원 직원">
        <bpmn:flowNodeRef>W07I_Supplement</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Receive</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneManager" name="영업지원팀장(전결)">
        <bpmn:flowNodeRef>W07I_Delegated</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneAccounting" name="회계팀">
        <bpmn:flowNodeRef>W07I_Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Rework</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Reconcile</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Finish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneSystem" name="시스템">
        <bpmn:flowNodeRef>W07I_AIReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_AIRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_EarlyAlert</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Route</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_OpenBoth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Join</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Outcome</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Prepay</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneSales" name="영업 임원">
        <bpmn:flowNodeRef>W07I_Regular</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_Business</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_BusinessStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_BusinessMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneFinance" name="재무 임원">
        <bpmn:flowNodeRef>W07I_FinanceVote</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_FinanceStop</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>W07I_FinanceMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="W07I_LaneTreasury" name="자금팀">
        <bpmn:flowNodeRef>W07I_Pay</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="W07I_Start" name="정산 요청">
      <bpmn:outgoing>W07I_Flow01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="W07I_Receive" name="신규 등록·묶음 접수">
      <bpmn:documentation>직접 입력·CSV 신규 요청과 기존 미지급 요청을 관련자 그룹·지급예정월로 묶고 이번 결재 대상을 선택한다. 선택 금액과 유효 지급 월 합산액을 각각 기록한다. 요청서와 증빙을 건 ID에 연결한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow01</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="W07I_EarlyAlert" name="접수 등록 위험 표시 시 동시 알림">
      <bpmn:documentation>접수 정보에서 위험을 확인하면 해당 건을 영업·재무 승인함에 같은 시점에 등록하고 양쪽에 동시에 알린다. 이때는 열람만 가능하다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow02</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="W07I_Review" name="증빙 취합·합산 지급 근거 검토">
      <bpmn:documentation>회계가 관련 거래처와 월 합산액, 지급 근거, 이해상충 및 예외를 확인한다. 접수 이후 위험을 새로 식별하면 해당 시점에 양쪽에 알린다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow03</bpmn:incoming>
      <bpmn:incoming>W07I_Flow22</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="W07I_Route" name="승인권자 결정 근거 버전 확정">
      <bpmn:documentation>일반 건은 월 합산액 200만 원 이하이면 영업지원팀장(전결), 초과하면 영업 임원 결재다. 특별승인은 금액에 관계없이 영업 임원과 재무 임원이 결재한다. 이해상충 당사자가 필수 승인자이면 적격 경로 부재로 기록하고 지급을 보류한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow04</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W07I_Risk" name="승인 경로 확정?" default="W07I_Flow27">
      <bpmn:documentation>이해상충, 정상 정책을 벗어난 지급 요청, 관련자 합산 예외 또는 수취계좌 변경을 포함한다. 예외로 등록된 건은 소명 후에도 이번 검토 건의 이중승인을 유지한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow05</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow06</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow07</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow27</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow32</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="W07I_Regular" name="영업 임원 일반 결재">
      <bpmn:documentation>월 합산 200만 원 초과 일반 건의 승인, 보완 요청, 반려를 기록한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow06</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="W07I_Delegated" name="영업지원팀장(전결)">
      <bpmn:documentation>200만 원 이하 일반 건을 접수자와 다른 영업지원팀장가 결정한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow32</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="W07I_OpenBoth" name="두 결재 요청 동시 발행">
      <bpmn:documentation>동일한 검토 버전으로 영업과 재무 양쪽 승인함에 결재 요청을 함께 발행한 뒤 두 결재를 활성화한다. 양쪽 화면에 상대 결재 필요 여부와 상태를 표시한다. 한쪽 발행이 실패하면 두 결재 모두 활성화하지 않고 재처리한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow07</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="W07I_Fork">
      <bpmn:incoming>W07I_Flow08</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow09</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow10</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="W07I_Business" name="사업상 타당성 결재">
      <bpmn:documentation>영업 임원은 해당 버전의 사업상 타당성을 독립적으로 검토한다. 이해상충 당사자는 결재할 수 없다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow09</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="W07I_FinanceVote" name="합산·증빙·지급 조건 결재">
      <bpmn:documentation>재무 임원은 영업부문과 독립적으로 합산·증빙·수취계좌를 확인하고 승인·보완 요청·반려를 결정한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow10</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="W07I_BusinessStop" attachedToRef="W07I_Business" cancelActivity="true">
      <bpmn:documentation>재무 측 보완·반려 또는 승인 근거 변경으로 이 결재가 중단된다.</bpmn:documentation>
      <bpmn:outgoing>W07I_Flow12</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="W07I_BusinessStopCondition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">재무 측 보완·반려 또는 승인 근거 변경으로 이 결재가 중단된다.</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="W07I_FinanceStop" attachedToRef="W07I_FinanceVote" cancelActivity="true">
      <bpmn:documentation>영업 측 보완·반려 또는 승인 근거 변경으로 이 결재가 중단된다.</bpmn:documentation>
      <bpmn:outgoing>W07I_Flow14</bpmn:outgoing>
      <bpmn:conditionalEventDefinition id="W07I_FinanceStopCondition">
        <bpmn:condition xsi:type="bpmn:tFormalExpression">영업 측 보완·반려 또는 승인 근거 변경으로 이 결재가 중단된다.</bpmn:condition>
      </bpmn:conditionalEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="W07I_BusinessMerge">
      <bpmn:incoming>W07I_Flow11</bpmn:incoming>
      <bpmn:incoming>W07I_Flow12</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="W07I_FinanceMerge">
      <bpmn:incoming>W07I_Flow13</bpmn:incoming>
      <bpmn:incoming>W07I_Flow14</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="W07I_Join">
      <bpmn:incoming>W07I_Flow15</bpmn:incoming>
      <bpmn:incoming>W07I_Flow16</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow17</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="W07I_Outcome" name="결재 결과">
      <bpmn:documentation>현재 버전에 필요한 모든 결재가 승인인 경우에만 지급 전 확인으로 간다. 한쪽의 보완 요청이나 반려는 즉시 지급 차단 상태를 기록하고 상대 미결 결재를 닫는다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow17</bpmn:incoming>
      <bpmn:incoming>W07I_Flow18</bpmn:incoming>
      <bpmn:incoming>W07I_Flow33</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow19</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow20</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="W07I_Rework" name="지급 보류·보완 확인">
      <bpmn:documentation>회계가 보완 회신과 AI 인용 근거를 확인한다. 미등록 상황과 적격 승인 경로 부재는 상위 보고 사유를 기록하고 근거와 경로가 확보될 때까지 지급을 보류한다. 확인한 새 근거로 재검토한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow20</bpmn:incoming>
      <bpmn:incoming>W07I_Flow23</bpmn:incoming>
      <bpmn:incoming>W07I_Flow30</bpmn:incoming>
      <bpmn:incoming>W07I_Flow31</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="W07I_AIReview" name="지급보류 · AI 증빙 판단">
      <bpmn:documentation>증빙 누락, 미등록 상황, 적격 승인 경로 부재를 지급보류로 저장한다. AI가 근거를 인용해 자료 보완 또는 회계 확인과 상위 보고를 제안한다. 서버가 범위·인용·입력 버전을 검증한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow27</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="W07I_AIRoute" name="보강 자료 있음?" default="W07I_Flow30">
      <bpmn:incoming>W07I_Flow28</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow29</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="W07I_Supplement" name="영업지원 보완 회신">
      <bpmn:documentation>AI가 확인한 요청 자료와 근거를 보고 해당 작업에 보완 증빙을 연결한다. 회계팀이 회신을 검토한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow29</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="W07I_Rejected" name="반려 종료">
      <bpmn:incoming>W07I_Flow21</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="W07I_Prepay" name="승인 근거 유효?">
      <bpmn:documentation>지급 직전에 동일한 승인 버전과 결재 완료를 확인한다. 지급 대상, 금액, 수취계좌, 적용 월, 관련자 그룹·한도 판단 또는 예외 판정이 달라지면 기존 승인을 무효화하고 미집행 지급을 보류한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow19</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow23</bpmn:outgoing>
      <bpmn:outgoing>W07I_Flow24</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="W07I_Pay" name="승인 조건대로 지급 지시">
      <bpmn:documentation>지급 지시를 기록하는 시점에 승인 버전과 지급 조건을 함께 확인한다. MVP에서는 모의 지급 지시를 생성하고 은행 회신은 별도 입력으로 받는다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow24</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="W07I_Reconcile" name="은행 회신·전표 대사">
      <bpmn:documentation>회계가 승인 내역·지급 지시·은행 결과·전표를 건별로 확인한다. 일치하면 대사 완료, 차이가 있으면 차이와 후속 확인 작업을 기록한다. 모의 은행 회신이 없으면 회신 대기를 유지한다.</bpmn:documentation>
      <bpmn:incoming>W07I_Flow25</bpmn:incoming>
      <bpmn:outgoing>W07I_Flow26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="W07I_Finish" name="대사 결과 기록">
      <bpmn:incoming>W07I_Flow26</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="W07I_Flow01" sourceRef="W07I_Start" targetRef="W07I_Receive"/>
    <bpmn:sequenceFlow id="W07I_Flow02" sourceRef="W07I_Receive" targetRef="W07I_EarlyAlert"/>
    <bpmn:sequenceFlow id="W07I_Flow03" sourceRef="W07I_EarlyAlert" targetRef="W07I_Review"/>
    <bpmn:sequenceFlow id="W07I_Flow04" sourceRef="W07I_Review" targetRef="W07I_Route"/>
    <bpmn:sequenceFlow id="W07I_Flow05" sourceRef="W07I_Route" targetRef="W07I_Risk"/>
    <bpmn:sequenceFlow id="W07I_Flow06" sourceRef="W07I_Risk" targetRef="W07I_Regular" name="일반 · 200만 원 초과">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">검토가 완료된 200만 원 초과 일반 건이며 적격 영업 임원이 배정됨</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow07" sourceRef="W07I_Risk" targetRef="W07I_OpenBoth" name="예외">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">증빙과 합산 검토가 끝났고 특별승인 사유가 있으며 영업·재무의 두 임원이 모두 적격함</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="W07I_Flow08" sourceRef="W07I_OpenBoth" targetRef="W07I_Fork"/>
    <bpmn:sequenceFlow id="W07I_Flow09" sourceRef="W07I_Fork" targetRef="W07I_Business"/>
    <bpmn:sequenceFlow id="W07I_Flow10" sourceRef="W07I_Fork" targetRef="W07I_FinanceVote"/>
    <bpmn:sequenceFlow id="W07I_Flow11" sourceRef="W07I_Business" targetRef="W07I_BusinessMerge"/>
    <bpmn:sequenceFlow id="W07I_Flow12" sourceRef="W07I_BusinessStop" targetRef="W07I_BusinessMerge"/>
    <bpmn:sequenceFlow id="W07I_Flow13" sourceRef="W07I_FinanceVote" targetRef="W07I_FinanceMerge"/>
    <bpmn:sequenceFlow id="W07I_Flow14" sourceRef="W07I_FinanceStop" targetRef="W07I_FinanceMerge"/>
